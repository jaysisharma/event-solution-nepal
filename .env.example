# Database connection string
# For PostgreSQL (Docker / Local / Remote Supabase, Neon, etc.):
DATABASE_URL="postgresql://postgres:password@localhost:5432/event_solution_db?schema=public"

# If switching to SQLite for local development (with existing prisma/dev.db):
# 1. Update prisma/schema.prisma provider to "sqlite"
# 2. Run: npx prisma generate
# DATABASE_URL="file:./dev.db"

# Authentication secret (used for session JWT tokens)
AUTH_SECRET="your-super-secret-jwt-key-min-12-chars"

# Cloudinary (Media uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
NEXT_PUBLIC_CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Email Configuration (Gmail App Password)
EMAIL_USER="info@eventsolutionnepal.com.np"
EMAIL_PASS="your-app-password"

# Khalti Payment Gateway
KHALTI_SECRET_KEY="your_khalti_secret_key"

# Google Analytics (Optional)
NEXT_PUBLIC_GA_ID=""
